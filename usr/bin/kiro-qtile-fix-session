#!/bin/sh
#####################################################################
# Author    : Erik Dubois
# Website   : https://kiroproject.be
#####################################################################
#   DO NOT JUST RUN THIS. EXAMINE AND JUDGE. RUN AT YOUR OWN RISK.
#
# Purpose:
#   Repair the session files shipped by the qtile package.
#   qtile 0.37 ships Exec=/bin/sh -c "systemctl --user ... qtile.service".
#   SDDM's /usr/share/sddm/scripts/Xsession ends in a bare "exec $@" --
#   word splitting, no eval -- so the quotes are never processed, sh -c
#   gets the literal token "systemctl and dies with a syntax error. The
#   session lasts under a second and SDDM returns to the greeter.
#   This rewrites Exec= to the plain form, which survives word splitting,
#   and hides the Wayland entry (Kiro qtile is X11).
# Why:
#   Both files belong to the qtile package, so every qtile upgrade puts
#   the broken Exec back. A pacman hook runs this again each time.
#####################################################################

xsession=/usr/share/xsessions/qtile.desktop
wayland_session=/usr/share/wayland-sessions/qtile.desktop

if [ ! -f "$xsession" ]; then
    echo "kiro-qtile-fix-session: $xsession is missing -- qtile session left unpatched" >&2
    exit 1
fi

# Anchored on ^Exec= rather than on upstream's current wrapper, so this keeps
# working if upstream changes the wrapper again.
sed -i 's|^Exec=.*|Exec=qtile start -b x11|' "$xsession"

# The Wayland session is hidden rather than removed, same as kiro-xfce does
# with xfce-wayland.desktop. Absent is fine -- not every box has it.
[ -f "$wayland_session" ] || exit 0
grep -q '^NoDisplay=true$' "$wayland_session" && exit 0
printf 'NoDisplay=true\n' >> "$wayland_session"
